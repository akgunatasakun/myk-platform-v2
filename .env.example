# MYK Platform V2 — Ortam Değişkenleri Şablonu
# Kopyala: cp .env.example .env  (GIT'E EKLEME!)

# ── Ortam ─────────────────────────────────────────────────────────────────
MYK_ENV=development          # development | test | production

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=myk_platform
POSTGRES_USER=myk_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# DATABASE_URL: docker-compose.yml içinde POSTGRES_* değişkenlerinden otomatik oluşturulur.
# Doğrudan bağlantı için (migration, lokal test) aşağıyı doldur:
# DATABASE_URL=postgresql+asyncpg://myk_user:CHANGE_ME_STRONG_PASSWORD@localhost:5432/myk_platform

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────
# Üret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_64_CHAR_HEX_SECRET
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ── Güvenlik ──────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_FLASK_STYLE_SECRET
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com
CORS_ALLOW_CREDENTIALS=true

# Kurulum endpoint güvenliği
# Production'da false yapın — ilk kurulumdan sonra yeni kulüp oluşturulmasın
ALLOW_PUBLIC_SETUP=false

# ── Dosya Yükleme ─────────────────────────────────────────────────────────
MAX_UPLOAD_MB=15
STORAGE_BACKEND=local        # local | s3
STORAGE_PATH=/app/storage

# ── Object Storage (MinIO staging / S3 production) ────────────────────────
# Staging: MinIO dahili container (docker-compose otomatik wires STORAGE_ENDPOINT)
# Production: Hetzner Object Storage veya AWS S3 — endpoint + credentials değiştir
STORAGE_ENDPOINT=http://minio:9000
# Üret: python -c "import secrets; print(secrets.token_hex(16))"
STORAGE_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
STORAGE_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
STORAGE_BUCKET=myk-person-media
STORAGE_REGION=us-east-1
STORAGE_SECURE=false         # MinIO HTTP=false; Production HTTPS=true

# ── PDF Servisi ────────────────────────────────────────────────────────────
PDF_SERVICE_URL=http://pdf-service:8001

# ── İlk Yönetici (kurulum sırasında oluşturulur) ──────────────────────────
# ÖNEMLİ: Kaynak koda YAZILMAZ, yalnızca .env ile iletilir
INITIAL_ADMIN_EMAIL=admin@kulup.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
INITIAL_CLUB_NAME=Mersin Yelken ve Yat Sporları Kulübü
INITIAL_CLUB_SLUG=myk

# ── E-posta (Aşama 4) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@kulup.com
SMTP_USE_TLS=false
SMTP_START_TLS=true

# ── Celery (Aşama 4) ──────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Loglama ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
