# MYK Platform V2 — Production Ortam Değişkenleri Şablonu
# Kopyala: cp .env.production.example .env  (GIT'E ASLA EKLEME!)
# Bu dosya docker-compose.prod.yml ile birlikte kullanılır.

# ── Ortam ─────────────────────────────────────────────────────────────────────
MYK_ENV=production

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=myk_platform_prod
POSTGRES_USER=myk_user_prod
# Üret: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_32_CHARS

# DATABASE_URL: docker-compose.prod.yml içinde otomatik oluşturulur.
# Doğrudan bağlantı için: postgresql+asyncpg://<user>:<pass>@localhost:5432/<db>

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# Üret: python -c "import secrets; print(secrets.token_hex(32))"
# EN AZ 64 karakter hexadecimal, REPLACE_WITH_ içermemeli
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ── Güvenlik ──────────────────────────────────────────────────────────────────
# Üret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX
ALLOWED_ORIGINS=https://yourdomain.com
CORS_ALLOW_CREDENTIALS=true

# Kurulum endpoint — production'da MUTLAKA false
# (config validator true ise başlatmayı reddeder)
ALLOW_PUBLIC_SETUP=false

# ── Dosya Yükleme ─────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=15
STORAGE_BACKEND=local
STORAGE_PATH=/app/storage

# ── Object Storage (MinIO / S3-uyumlu) ────────────────────────────────────────
# MinIO (bundled container): STORAGE_ENDPOINT=http://minio:9000, STORAGE_SECURE=false
# Harici Hetzner Object Storage: STORAGE_ENDPOINT=https://<region>.your-objectstorage.com
# Harici AWS S3: STORAGE_ENDPOINT=https://s3.<region>.amazonaws.com
STORAGE_ENDPOINT=http://minio:9000
# Üret: python -c "import secrets; print(secrets.token_hex(16))"
STORAGE_ACCESS_KEY=REPLACE_WITH_MINIO_OR_S3_ACCESS_KEY
STORAGE_SECRET_KEY=REPLACE_WITH_MINIO_OR_S3_SECRET_KEY
STORAGE_BUCKET=myk-person-media
STORAGE_REGION=us-east-1
# MinIO HTTP kullanırken false, harici HTTPS endpoint'inde true
STORAGE_SECURE=false

# ── PDF Servisi ────────────────────────────────────────────────────────────────
PDF_SERVICE_URL=http://pdf-service:8001

# ── Loglama ───────────────────────────────────────────────────────────────────
LOG_LEVEL=WARNING

# ── İlk Yönetici (ilk kurulumda oluşturulur, sonra ALLOW_PUBLIC_SETUP=false yapılır) ──
# Bu değerleri ilk deploy'dan sonra silmek veya değiştirmek iyi pratiktir.
INITIAL_ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
INITIAL_CLUB_NAME=Mersin Yelken ve Yat Sporları Kulübü
INITIAL_CLUB_SLUG=myk

# ── E-posta (Sprint 4) ────────────────────────────────────────────────────────
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@yourdomain.com
SMTP_USE_TLS=false
SMTP_START_TLS=true

# ── Celery (Sprint 4) ─────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─────────────────────────────────────────────────────────────────────────────
# DEPLOY ÖNCESİ KONTROL LİSTESİ:
#   [ ] JWT_SECRET_KEY gerçek rastgele değer (≥64 char, REPLACE_WITH_ yok)
#   [ ] SECRET_KEY gerçek rastgele değer (≥64 char, REPLACE_WITH_ yok)
#   [ ] POSTGRES_PASSWORD güçlü (≥32 char)
#   [ ] STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY dolu
#   [ ] ALLOW_PUBLIC_SETUP=false
#   [ ] MYK_ENV=production
#   [ ] ALLOWED_ORIGINS gerçek domain (https://)
#   [ ] INITIAL_ADMIN_EMAIL gerçek e-posta adresi
#   [ ] .env dosyası git'e eklenmedi (git status ile kontrol et)
# ─────────────────────────────────────────────────────────────────────────────
