# MYK Platform V2 — Production Ortam Değişkenleri Şablonu
# Kopyala: cp .env.production.example .env  (GIT'E ASLA EKLEME!)
# Bu dosya docker-compose.prod.yml ile birlikte kullanılır.

# ── Ortam ─────────────────────────────────────────────────────────────────────
MYK_ENV=production

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=myk_platform_prod
POSTGRES_USER=myk_user_prod
# GÜÇLİ PAROLA: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_32_CHARS

# DATABASE_URL: docker-compose.prod.yml içinde otomatik oluşturulur.
# Doğrudan bağlantı için: postgresql+asyncpg://<user>:<pass>@localhost:5432/<db>

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# Üret: python -c "import secrets; print(secrets.token_hex(32))"
# EN AZ 64 karakter hexadecimal, CHANGE_ME içermemeli
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_e.g._python_secrets_token_hex_32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ── Güvenlik ──────────────────────────────────────────────────────────────────
# Üret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_e.g._python_secrets_token_hex_32
ALLOWED_ORIGINS=https://yourdomain.com
CORS_ALLOW_CREDENTIALS=true

# Kurulum endpoint — production'da MUTLAKA false
# (config validator true ise başlatmayı reddeder)
ALLOW_PUBLIC_SETUP=false

# ── Dosya Yükleme ─────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=15
STORAGE_BACKEND=local
STORAGE_PATH=/app/storage

# ── Loglama ───────────────────────────────────────────────────────────────────
LOG_LEVEL=WARNING

# ── E-posta (Aşama 4) ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com

# ── Celery (Aşama 4) ──────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─────────────────────────────────────────────────────────────────────────────
# KONTROL LİSTESİ (deploy öncesi):
#   [ ] JWT_SECRET_KEY gerçek rastgele değer (≥64 char, CHANGE_ME yok)
#   [ ] SECRET_KEY gerçek rastgele değer (≥64 char, CHANGE_ME yok)
#   [ ] POSTGRES_PASSWORD güçlü (≥32 char)
#   [ ] ALLOW_PUBLIC_SETUP=false
#   [ ] MYK_ENV=production
#   [ ] ALLOWED_ORIGINS gerçek domain
#   [ ] .env dosyası git'e eklenmedi
# ─────────────────────────────────────────────────────────────────────────────
